    },
    {
      "id": "hinge-clips-not-through-stitching",
      "statement": "Clip into the seam allowance to form hinges, but do not cut through the stitching line.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": null,
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "101,104"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "even-then-uneven",
      "statement": "When a change is both even and uneven, make the even part first, then pivot the remaining section so the edges align.",
      "applies_to": [
        "all"
      ],
      "operation": "pivot_points",
      "check": "max_turn_deg",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "103-104"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "duplicate-and-retrace",
      "statement": "The pivot method duplicates the area to be altered, moves the duplicate, and traces the new cutting line, so the new edge keeps the original contour.",
      "applies_to": [
        "all"
      ],
      "operation": "pivot_points",
      "check": "max_turn_deg",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "104-106"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "asymmetric-taper-to-centre",
      "statement": "For an asymmetric figure, the altered half is tapered back to the original at centre back or centre front, so the two halves join at the centre line.",
      "applies_to": [
        "all"
      ],
      "operation": "taper_side_seam",
      "check": "max_turn_deg",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "107"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "ease-depends-on-fabric",
      "statement": "Ease depends on the fabric. A design made for stretch fabric has some ease removed, and the same design in woven fabric will be too tight at bust, upper arm and hip.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "ease_matches_fabric",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "12"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "layers-nest",
      "statement": "Each outer layer (interlining, lining, outer garment) is cut slightly larger than the layer beneath, so the layers lie smoothly over one another.",
      "applies_to": [
        "jackets",
        "coats",
        "layered-garments"
      ],
      "operation": null,
      "check": "layer_order_sizes",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "13"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "bulky-fabric-more-ease",
      "statement": "Heavier, bulkier fabric needs more ease than light fabric in the same style.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "ease_matches_fabric",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "12"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "balance-both-sides",
      "statement": "A garment must look balanced both side to side and top to bottom. Symmetrical balance is equal on each side of the centre line; asymmetrical balance needs equal visual weight.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": null,
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "14"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "single-dominant-emphasis",
      "statement": "A garment should have one dominant point of interest, with others subordinate. Attention can be moved away from a figure variation by a stronger detail.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": null,
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "17-18"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "choose-style-to-solve-fit",
      "statement": "Some fit problems are solved by choosing or modifying the style, such as omitting a shoulder pad on a square shoulder, rather than altering the pattern.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": null,
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "19"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "figure-mirror-check",
      "statement": "Assume each side of the body is a mirror of the other only until measured. Asymmetry is common and must be checked for each area: neck slope, shoulder length and height, back and chest width, bust, waist, hip, and limbs.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "asymmetry_checked",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "36"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "standard-proportions-reference",
      "statement": "Standard proportions give a starting reference: back neck-to-waist about equal to shoulder width; hip about equal to or slightly less than shoulder width; bust about equal to hip; waist about ten inches less than bust.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "proportion_reference",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "34"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "posture-before-alteration",
      "statement": "Check posture before altering, because posture can cause many fit problems that correct themselves when posture changes. Rounded upper backs and swayed backs change the length of the back and front.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": null,
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "37-38"
      },
      "status": "draft",
      "reviewer": null
    }
