        "pages": "89-90"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "sleeveless-side-seam-rise",
      "statement": "Side seams of sleeveless tops may rise higher at the underarm than side seams of tops with sleeves.",
      "applies_to": [
        "tops-sleeveless"
      ],
      "operation": "move_seam",
