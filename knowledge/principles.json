    },
    {
      "id": "sleeve-cap-ease",
      "statement": "Sleeve cap seams are about 3/4 to 1 inch larger than the bodice armscye they fit, to allow for movement.",
      "applies_to": [
        "tops-sleeved",
        "dresses-sleeved",
        "jackets"
      ],
      "operation": null,
      "check": "sleeve_cap_ease",
