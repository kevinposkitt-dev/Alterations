    {
      "id": "taper-to-nothing",
      "statement": "A slash or pivot change is tapered out to nothing at a seam, crease or hipline, so the new line blends into the original.",
      "applies_to": [
        "all"
      ],
      "operation": "taper_side_seam",
      "check": "max_turn_deg",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "189-197"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "width-then-armscye-then-darts",
      "statement": "Order of work for a bust fit: adjust width first, then armscye and side seam, then waist darts.",
      "applies_to": [
        "tops",
        "dresses",
        "jackets"
      ],
      "operation": "sequence",
      "check": "order_respected",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "289-291"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "back-length-independent",
      "statement": "When only the back is too long, shorten the back alone with a parallel tuck, and widen the back dart by the same amount.",
      "applies_to": [
        "tops",
        "jackets"
      ],
      "operation": "shorten_back",
      "check": "back_front_independent",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "289"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "order-length-then-width",
      "statement": "Make alterations in this order: length changes first (even, then uneven, then combined), then width changes (even, then uneven, then combined).",
      "applies_to": [
        "all"
      ],
      "operation": "sequence",
      "check": "order_respected",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "111"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "blend-asymmetric-to-centre",
      "statement": "Asymmetric alterations are blended out to nothing at the pattern centre, and dart tips keep the same height from the floor.",
