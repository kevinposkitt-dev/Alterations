{
  "schema": "principle: id, statement (own words), applies_to, operation, check, source {book, pages}, status, reviewer",
  "principles": [
    {
      "id": "ease-fixed-amount",
      "statement": "Ease is a fixed amount added at each body measurement, not a shape change.",
      "applies_to": [
        "tops",
        "dresses",
        "jackets"
      ],
      "operation": null,
      "check": "ease_at_measurement_within_range",
      "source": {
        "book": "Make Your Own Patterns (Bergh)",
        "pages": "16"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "side-seams-match",
      "statement": "Front and back side seams and shoulder seams must correspond in length after any change.",
      "applies_to": [
        "tops",
        "dresses",
        "jackets",
        "trousers"
      ],
      "operation": "move_seam",
      "check": "seam_lengths_match",
      "source": {
        "book": "Make Your Own Patterns (Bergh)",
        "pages": "16"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "armhole-drafted-from-points",
      "statement": "The armhole is a separate curve drafted from set points. Changes to width or waist should not reshape it.",
      "applies_to": [
        "tops",
        "dresses",
        "jackets"
      ],
      "operation": "move_seam",
      "check": "armhole_unchanged",
      "source": {
        "book": "Make Your Own Patterns (Bergh)",
        "pages": "17"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "knit-tops-dartless",
      "statement": "For knit tops the book starts from a dartless foundation rather than shaping the waist with darts.",
      "applies_to": [
        "tops-knit"
      ],
      "operation": "taper_side_seam",
