        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "116"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "prepare-pattern-flat",
      "statement": "Work on a pressed, flat pattern with the printed side up, and mark alteration lines clearly. No puckers or wrinkles may remain after an alteration.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "pattern_flat",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "99-100"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "adjoining-edges-equal",
      "statement": "A change to one edge must be matched by equal amounts at the stitching line of each adjoining edge, otherwise the pieces will not join.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "adjoining_changes_equal",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "99"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "centre-lines-straight-and-square",
      "statement": "Centre front and centre back stay straight. Seams that meet them meet at right angles, and length changes there are spread evenly about 7.5-10 cm from the centre.",
      "applies_to": [
        "all"
      ],
      "operation": null,
      "check": "edges_square_and_straight",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "100"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "plan-alteration-at-edge",
      "statement": "Plan the alteration in the area nearest the edge that needs change, which keeps distortion to a minimum.",
      "applies_to": [
        "all"
      ],
      "operation": "slash_and_spread",
      "check": "max_turn_deg",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
