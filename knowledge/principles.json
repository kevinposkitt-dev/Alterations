      "operation": null,
      "check": "edges_square_and_straight",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "116"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "seams-smooth-at-joins",
      "statement": "Waistlines, necklines and armscye seams form a continuous smooth line where they meet side seams, shoulders and underarms.",
      "applies_to": [
        "tops",
