        "pages": "76"
      },
      "status": "draft",
      "reviewer": null
    },
    {
      "id": "uneven-side-split",
      "statement": "When a side-seam width change is uneven, the front takes one quarter of the side change and the back takes one half.",
      "applies_to": [
        "tops",
        "dresses",
        "trousers"
      ],
      "operation": "split_side_change",
