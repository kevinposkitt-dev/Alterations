{
  "description": "Index of design principles from the source books, in our own words, with page references. Each entry links to any construction or fit rule it affects. Draft until reviewed.",
  "entries": [
    {
      "category": "Elements: colour",
      "term": "Warm, light, bright colours advance and enlarge; cool, dark, dull colours recede and reduce",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "9-10"
      },
      "affects": [
        "fit-perception"
      ],
      "status": "draft"
    },
    {
      "category": "Elements: colour",
      "term": "Colour changes break the body into areas, which can shorten or lengthen a visual division",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "10"
      },
      "affects": [
        "fit-perception"
      ],
      "status": "draft"
    },
    {
      "category": "Elements: texture",
      "term": "Texture changes how size and weight read; heavy or matt textures add bulk, shiny or drapey ones show contour",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "11-13"
      },
      "affects": [
        "fit-perception",
        "ease"
      ],
      "status": "draft"
    },
    {
      "category": "Elements: texture",
      "term": "Fabric characteristics decide whether a design works; stretch and drape change fit as well as look",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "12"
      },
      "affects": [
        "ease-depends-on-fabric"
      ],
      "status": "draft"
    },
    {
      "category": "Principles: balance",
      "term": "Balance is the equal distribution of visual weight about a centre line, side to side and top to bottom",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "14"
      },
      "affects": [
        "balance-both-sides"
      ],
      "status": "draft"
    },
    {
      "category": "Principles: proportion",
      "term": "Uneven ratios such as 1:3, 2:3 and 3:5 read as the most interesting divisions of a garment",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "15"
      },
      "affects": [
        "fit-perception"
      ],
      "status": "draft"
    },
    {
      "category": "Principles: rhythm",
      "term": "Repetition, alternation, progression and continuous lines lead the eye through a garment",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "15-16"
      },
      "affects": [],
      "status": "draft"
    },
    {
      "category": "Principles: emphasis",
      "term": "One area should dominate; others are subordinate, and detail can move attention away from a figure variation",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "17"
      },
      "affects": [
        "single-dominant-emphasis"
      ],
      "status": "draft"
    },
    {
      "category": "Principles: harmony",
      "term": "All lines, shapes, colours and textures must relate to one another and to the purpose of the garment",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "17-18"
      },
      "affects": [],
      "status": "draft"
    },
    {
      "category": "Garment: knit tops",
      "term": "Knit tops are generally started from a dartless foundation; the waist is not shaped with darts",
      "source": {
        "book": "Make Your Own Patterns (Bergh)",
        "pages": "76"
      },
      "affects": [
        "knit-tops-dartless"
      ],
      "status": "draft"
    },
    {
      "category": "Garment: knit tops",
      "term": "Neck and waist ribbing are cut a set amount smaller than the neck or hem they sit on",
      "source": {
        "book": "Make Your Own Patterns (Bergh)",
        "pages": "76-77"
      },
      "affects": [],
      "status": "draft"
    },
    {
      "category": "Fitting standards",
      "term": "Centre seams hang perpendicular to the floor and are centred on the body",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "55-58"
      },
      "affects": [
        "fit-perception",
        "grainline"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting standards",
      "term": "Side seams slope forward from the underarm; darts point to the crown of the curve and end about 1 inch short of the fullest part",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "55-58"
      },
      "affects": [
        "side-seam",
        "darts"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting standards",
      "term": "Armscye sits about ½ inch from the arm surface; sleeve edge extends about ½ inch from the armscye",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "55-58"
      },
      "affects": [
        "armscye",
        "sleeve-cap-ease"
      ],
      "status": "draft"
    },
    {
      "category": "Basic ease",
      "term": "Basic ease depends on style: strapless and sleeveless need little; sportswear needs more than business wear",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "54"
      },
      "affects": [
        "ease"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting method",
      "term": "Work simple to complex and largest area first; fix length before circumference; hem last",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "65-66"
      },
      "affects": [
        "fit-order"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting method",
      "term": "Wrinkle direction shows the fault: tension means too small or too short; loose folds mean too long or the dart is too wide",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "67"
      },
      "affects": [
        "wrinkles",
        "ease",
        "darts"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting method",
      "term": "Circumference difference divided by four, applied parallel to the side seam",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "65"
      },
      "affects": [
        "ease",
        "side-seam"
      ],
      "status": "draft"
    },
    {
      "category": "Garment units",
      "term": "Flare follows the bias; pleats, gathers and drape each need controlled ease and grain",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "59-60"
      },
      "affects": [
        "ease",
        "grainline"
      ],
      "status": "draft"
    },
    {
      "category": "Garment units",
      "term": "Collar and pocket fit follow the neckline, shoulder slope and the body contour under them",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "60-61"
      },
      "affects": [
        "collar",
        "pockets"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting methods",
      "term": "Pinned pattern: overlap seam allowances on matching stitch lines; never pin them outward or inward",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "71"
      },
      "affects": [
        "pinned-pattern",
        "ease"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting methods",
      "term": "Trial garment (muslin): plain-weave medium fabric; mark centre lines and crosswise lines; fit units simple to complex",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "74-78"
      },
      "affects": [
        "trial-garment",
        "grainline"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting methods",
      "term": "Fitting bands at scye, waist and fullest hip; centre marks on bands align to centre front and back",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "73"
      },
      "affects": [
        "centre-lines",
        "fit-order"
      ],
      "status": "draft"
    },
    {
      "category": "Fitting methods",
      "term": "Judge total fit by moving through the motions the garment will be worn in",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "70"
      },
      "affects": [
        "ease",
        "fit-check"
      ],
      "status": "draft"
    },
    {
      "category": "Measurement method",
      "term": "Measure at stated levels (armhole ¾ to 1 inch below the arm hinge, blade width 1 to 1¼ inches above it); record back and front separately",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "82-83"
      },
      "affects": [
        "measurement",
        "armscye"
      ],
      "status": "draft"
    },
    {
      "category": "Measurement method",
      "term": "Skirt and trouser length and width: which measurement tells which change (above the hipline, at the hem, side seam or dart)",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "84-86"
      },
      "affects": [
        "skirt-length",
        "hip-depth",
        "width"
      ],
      "status": "draft"
    },
    {
      "category": "Pattern comparison",
      "term": "Bodice: which measurement agrees decides the change (armscye depth, armhole height, centre length, dart size, bust level)",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "91-92"
      },
      "affects": [
        "armscye",
        "bodice-length",
        "darts"
      ],
      "status": "draft"
    },
    {
      "category": "Pattern comparison",
      "term": "Sleeve: underarm and elbow measures decide whether the change goes above or below the elbow",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "95-98"
      },
      "affects": [
        "sleeve-length",
        "sleeve-width"
      ],
      "status": "draft"
    },
    {
      "category": "Pattern comparison",
      "term": "Trouser crotch: remaining difference split one third front, two thirds back",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "89"
      },
      "affects": [
        "crotch",
        "trousers"
      ],
      "status": "draft"
    },
    {
      "category": "Alteration methods",
      "term": "Slash: cut the interior, spread or overlap; uneven changes distort the edge and dart size",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "100-102"
      },
      "affects": [
        "slash-method",
        "darts"
      ],
      "status": "draft"
    },
    {
      "category": "Alteration methods",
      "term": "Seam: free the seam allowance, pivot at change points, keep the interior uncut",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "103-104"
      },
      "affects": [
        "seam-method",
        "seam-allowance"
      ],
      "status": "draft"
    },
    {
      "category": "Alteration methods",
      "term": "Pivot: trace the duplicate, move it by pivot points, retrace in a contrasting colour",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "105-107"
      },
      "affects": [
        "pivot-method"
      ],
      "status": "draft"
    },
    {
      "category": "Alteration methods",
      "term": "Asymmetric figures: alter each half; taper to centre; keep dart tips level on both sides",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "107"
      },
      "affects": [
        "asymmetry",
        "darts",
        "centre-lines"
      ],
      "status": "draft"
    },
    {
      "category": "Finished-pattern checks",
      "term": "Right angles at hems and neck; straight centres; equal dart lengths; smooth joins at waist, neck, shoulder, armscye",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "116-118"
      },
      "affects": [
        "checks",
        "joins",
        "darts"
      ],
      "status": "draft"
    },
    {
      "category": "Finished-pattern checks",
      "term": "Allowances at joins: waist ¼ inch larger than waistband; sleeve underarm ⅛ to ⅜ inch larger; cap ¾ to 1 inch larger (metric conversion to confirm)",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "116"
      },
      "affects": [
        "sleeve",
        "waistband",
        "armscye"
      ],
      "status": "draft"
    },
    {
      "category": "Figure variations",
      "term": "Hip area catalogue begins: 1 long lower torso (longer back darts, length above hipline); 2 short lower torso (shorten above hipline or raise side curve)",
      "source": {
        "book": "Fitting & Pattern Alteration (Liechty et al.)",
        "pages": "125-128"
      },
      "affects": [
        "hip",
        "darts",
        "hemline"
      ],
      "status": "draft"
    }
  ]
